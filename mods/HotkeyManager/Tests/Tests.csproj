<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2</GameDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ConditionChecks.cs" />
    <Compile Include="..\Integration\OptionalHotkeys.cs" Link="OptionalHotkeys.cs" />
    <ProjectReference Include="..\GK2.HotkeyManager.csproj" />
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" />
    <Reference Include="UnityEngine" HintPath="$(GameDir)\GraveyardKeeper2_Data\Managed\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\GraveyardKeeper2_Data\Managed\UnityEngine.CoreModule.dll" />
    <Reference Include="LazyBearTechnology" HintPath="$(GameDir)\GraveyardKeeper2_Data\Managed\LazyBearTechnology.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\GraveyardKeeper2_Data\Managed\Assembly-CSharp.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameDir)\GraveyardKeeper2_Data\Managed\UnityEngine.UI.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameDir)\GraveyardKeeper2_Data\Managed\Unity.TextMeshPro.dll" />
  </ItemGroup>
</Project>
